{
    "name": "bcl-discord-bridge",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "スマホ1台の人もDiscord経由でBetterCrewLinkの近接ボイスに参加できる中継アプリ",
    "license": "GPL-3.0-only",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "test": "vitest run",
        "check": "tsc -p tsconfig.json --noEmit && vitest run"
    },
    "dependencies": {
        "@discordjs/opus": "^0.10.0",
        "@discordjs/voice": "^0.19.0",
        "discord.js": "^14.22.1",
        "dotenv": "^17.2.2",
        "path-intersection": "4.1.0",
        "pino": "^9.9.4",
        "socket.io-client": "^4.8.1",
        "werift": "^0.24.4",
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@types/node": "^24.7.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Lizqxel/bcl-discord-bridge.git"
    }
}
